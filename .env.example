# ──────────────────────────────────────────────────────────────────────────────
# SGMS Frontend – Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# FIX: Renamed from REACT_APP_APPS_SCRIPT_URL (Create React App style) to
#      VITE_APPS_SCRIPT_URL. Vite requires the VITE_ prefix for env vars that
#      are exposed to the browser. process.env.REACT_APP_* is undefined in Vite.

# Google Apps Script Web App URL
# Get this from: Deploy → Manage Deployments → Web App URL
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# GitHub Pages base path (optional)
# Set this to /your-repo-name/ if deploying to username.github.io/your-repo-name/
# Leave as / for username.github.io (user/org site) or custom domain.
# VITE_BASE_PATH=/sgms/
