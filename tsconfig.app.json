{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* FIX: allowJs lets TypeScript resolve imports of the .js page/component
       files from App.tsx. Without this, `import Login from '@/pages/Login'`
       (which resolves to Login.js) fails type-checking with TS2307.
       checkJs:false means TS reads the .js files for types but does not
       report errors inside them. */
    "allowJs": true,
    "checkJs": false,

    /* Import alias */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "ignoreDeprecations": "6.0",

    /* Linting — relaxed so mixed JS/TS codebase builds cleanly */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
